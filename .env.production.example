# Copy to .env.production on the server (never commit the real file).
POSTGRES_USER=mindmate
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=mindmate

# Nebius Token Factory key for live Nemotron calls.
NEBIUS_API_KEY=

# live = call Nemotron; off = deterministic only.
MINDMATE_LLM_MODE=live
# Recorded-answer demo mode. Keep "off" in production so every AI answer is a live Nemotron call
# (or clearly labelled offline analysis). fallback/replay exist only for offline rehearsals.
MINDMATE_DEMO_CACHE=off

# Required for POST /admin/reset-demo.
MINDMATE_ADMIN_TOKEN=change-me-long-random

# Domain (or subdomain) for the backend API; its DNS A record must point at this server.
# Caddy gets the HTTPS certificate for it. No domain? <server-ip>.sslip.io resolves to the IP.
API_DOMAIN=api.example.com

# Frontend origins allowed to call the backend (exact URLs, comma-separated). No wildcard.
CORS_ORIGINS=https://mindmate-lyart.vercel.app
# Optional: also allow Vercel preview deployments, e.g. https://mindmate-[a-z0-9-]+\.vercel\.app
CORS_ORIGIN_REGEX=

# Only for the optional "frontend" profile (frontend served from this server instead of Vercel).
PUBLIC_API_URL=https://api.example.com

RATE_LIMIT_PER_MINUTE=120
