# Copy to .env.production on the server (never commit the real file).
POSTGRES_USER=mindmate
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=mindmate

# Nebius Token Factory key for live Nemotron calls.
NEBIUS_API_KEY=

# live = call Nemotron; off = deterministic only.
MINDMATE_LLM_MODE=live
# fallback = serve recorded answers only when Nebius fails; replay = never call the model.
MINDMATE_DEMO_CACHE=fallback

# Required for POST /admin/reset-demo.
MINDMATE_ADMIN_TOKEN=change-me-long-random

# Public URL the browser uses to reach the backend (baked into the frontend build).
PUBLIC_API_URL=http://YOUR-VM-ADDRESS:8000
# Frontend origins allowed to call the backend (the VM address and/or the Vercel domain).
CORS_ORIGINS=http://YOUR-VM-ADDRESS,https://YOUR-PROJECT.vercel.app

RATE_LIMIT_PER_MINUTE=120
