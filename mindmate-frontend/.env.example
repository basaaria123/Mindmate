# Base URL of the MindMate backend (FastAPI). Leave empty to use the built-in
# local mocks for memory/plan screens; the AI screens then call http://127.0.0.1:8000.
# Local backend:  VITE_API_BASE_URL=http://localhost:8000
# Production:     set in the Vercel project settings to the deployed backend URL.
VITE_API_BASE_URL=
