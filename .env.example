# ---- Model access (AI role) --------------------------------------------------
# Nebius Token Factory key. Keep real keys in .env only; never commit them.
NEBIUS_API_KEY=
# Optional overrides (defaults in app/services/llm_client.py):
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# MINDMATE_REASONING_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# MINDMATE_FAST_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# ---- Backend & memory (BE role) ---------------------------------------------
# PostgreSQL in production, e.g. postgresql+psycopg://mindmate:mindmate@localhost:5432/mindmate
# Leave unset to use a local SQLite file at data/mindmate.db.
DATABASE_URL=

# Create tables on start-up (true for local/dev). Production runs `alembic upgrade head`.
MINDMATE_AUTO_CREATE_SCHEMA=true
# Seed the demo persona when the database is empty.
MINDMATE_AUTO_SEED=true

# live  -> call Nemotron for practice evaluation when NEBIUS_API_KEY is set
# off   -> always use the deterministic rubric (demo fallback / tests)
MINDMATE_LLM_MODE=live

# Demo fallback for the AI endpoints: off | record | replay | fallback (see docs/backend.md).
MINDMATE_DEMO_CACHE=off
# MINDMATE_DEMO_CACHE_DIR=data/demo_cache

# Swap the demo persona without code changes (defaults live in data/).
# MINDMATE_SEED_PERSONA=data/seed_persona.json
# MINDMATE_OPPORTUNITIES_FILE=data/opportunities.json
# MINDMATE_QUESTION_BANK=data/question_bank.json

# Requests per minute per client IP; 0 disables the limiter.
RATE_LIMIT_PER_MINUTE=120
# Optional shared secret required as X-Admin-Token on POST /admin/reset-demo.
MINDMATE_ADMIN_TOKEN=
# Extra comma-separated CORS origins (the deployed frontend URL).
CORS_ORIGINS=

# ---- Tunable decision logic (defaults match docs/contracts/backend-api.md) --
MINDMATE_DEFAULT_DAILY_MINUTES=60
MINDMATE_PLAN_DAYS=14
WEAKNESS_SCORE_THRESHOLD=60
WEAKNESS_MIN_OCCURRENCES=2
WEAKNESS_SEVERE_SCORE=35
MINDMATE_HARD_DEADLINE_DAYS=3
PRIORITY_WEIGHT_ROLE_IMPACT=0.40
PRIORITY_WEIGHT_WEAKNESS_BOOST=0.25
PRIORITY_WEIGHT_GOAL_HIERARCHY=0.20
PRIORITY_WEIGHT_DEADLINE_URGENCY=0.15
